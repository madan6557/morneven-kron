<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="kron.db" />
        <include domain="database" path="kron.db-wal" />
        <include domain="database" path="kron.db-shm" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="kron.db" />
        <include domain="file" path="datastore/" />
        <include domain="file" path="receipts/" />
    </device-transfer>
</data-extraction-rules>
